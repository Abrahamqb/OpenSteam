<Window x:Class="OpenSteam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenSteam Manager" Height="600" Width="950"
        WindowStartupLocation="CenterScreen" Background="Transparent" 
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="#33FFFFFF" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#007ACC" Offset="0"/>
                        <GradientStop Color="#005A9E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#44FF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D2B2B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0,20,0,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33007ACC"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Grid.Effect>

        <Border x:Name="MainBorder" Background="#0F0F0F" CornerRadius="20" BorderThickness="1" BorderBrush="#33FFFFFF">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="Black" CornerRadius="20" 
                                Width="{Binding ElementName=MainBorder, Path=ActualWidth}" 
                                Height="{Binding ElementName=MainBorder, Path=ActualHeight}"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Background="#090909" Grid.Column="0" CornerRadius="20,0,0,20" BorderThickness="0,0,1,0" BorderBrush="#1AFFFFFF">
                    <StackPanel>
                        <StackPanel Margin="0,30,0,30" HorizontalAlignment="Center">
                            <TextBlock Text="OPENSTEAM" Foreground="White" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="MANAGER" Foreground="#007ACC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        </StackPanel>
                        
                        <StackPanel>
                            <RadioButton Content="🏠 Dashboard" IsChecked="True" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavHome_Click"/>
                            <RadioButton Content="⚡ Online Lua" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavOnline_Click"/>
                            <RadioButton Content="📚 Library" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavLibrary_Click"/>
                            <RadioButton Content="🏴‍ OnlineByPass" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavLibrary_Click"/>
                            <RadioButton Content="🛠 Extras" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavExtra_Click"/>
                            <RadioButton Content="⚙ Settings" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavSettings_Click"/>
                            <RadioButton Content="ℹ Information" Style="{StaticResource MenuRadioButton}" GroupName="Menu" Click="NavInfo_Click"/>
                        </StackPanel>
                        
                        <TextBlock x:Name="txtVersion" Text="v2.1 Beta" Foreground="#44FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,100,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>
                
                <Grid Grid.Column="1">
                    <Border Height="40" VerticalAlignment="Top" Background="Transparent" MouseDown="Drag_MouseDown" Panel.ZIndex="10">
                        <Button x:Name="ExitButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="45" Height="32" Style="{StaticResource ExitButtonStyle}" Click="ExitButton_Click" />
                    </Border>
                    
                    <ContentControl x:Name="DynamicContent" Margin="0,40,0,0" Visibility="Collapsed"/>
                    
                    <Grid x:Name="HomeGrid" Margin="0,40,0,0">
                        <Canvas IsHitTestVisible="False"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="DASHBOARD" Foreground="White" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,30">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            
                            <UniformGrid Columns="2" Width="470">
                                <Button x:Name="patchButton" Content="Patch Steam" Style="{StaticResource PrimaryAction}" Height="50" Click="patchButton_Click"/>
                                <Button x:Name="DeletePatchButton" Content="Delete Patch" Style="{StaticResource DangerAction}" Height="50" Click="DeletePatchButton_Click"/>
                                <Button x:Name="ResetSteam" Content="Restart Steam" Style="{StaticResource ModernButtonStyle}" Background="#1E1E1E" Height="50" Click="ResetSteam_Click"/>
                                <Button x:Name="Plugins" Content="Millennium + Plugin" Style="{StaticResource ModernButtonStyle}" Background="#1E1E1E" Height="50" Click="Plugins_Click"/>
                            </UniformGrid>
                            
                            <Button x:Name="ManualLuaButton" Content="Load Custom LuaLoader" Style="{StaticResource ModernButtonStyle}" Background="#1E1E1E" Height="40" Width="458" Margin="6,15,6,0" Click="ManualLua_Click"/>

                            <Border Background="#0FFFFFFF" CornerRadius="8" Margin="0,40,0,0" Padding="15,10" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Fill="#00FF00" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ParcheEstado" Text="Status: System Ready" Foreground="#88FFFFFF" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <Grid x:Name="SettingsGrid" Margin="0,40,0,0" Visibility="Collapsed">
                        <StackPanel Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                            <TextBlock Text="SETTINGS" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            
                            <TextBlock Text="GENERAL" Foreground="#007ACC" FontSize="13" FontWeight="Bold" Margin="0,0,0,15"/>
                            <CheckBox x:Name="DeleteAutoPatch_" Content="Delete patch on close" Foreground="White" Margin="0,8" Checked="DeleteAutoPatch" Unchecked="DeleteAutoPatch"/>
                            <CheckBox x:Name="AutoPatch_" Content="Auto-Patch on Launch" Foreground="White" Margin="0,8" Checked="AutoPatch" Unchecked="AutoPatch"/>
                            <CheckBox x:Name="CloseSteamPatch_" Content="Close Steam before Patching" Foreground="White" Margin="0,8" Checked="CloseSteamPatch" Unchecked="CloseSteamPatch"/>
                            <CheckBox x:Name="DisableNFSWAlert_" Content="Disable the NSFW alert" Foreground="White" Margin="0,8" Checked="DisableNFSWAlert" Unchecked="DisableNFSWAlert"/>

                            <TextBlock Text="STEAM" Foreground="#007ACC" FontSize="13" FontWeight="Bold" Margin="0,20,0,15"/>
                            <CheckBox x:Name="DisableWebHelper_" Content="Disable Web Helper" Foreground="White" Margin="0,8,0,25" Checked="DisableWebHelper" Unchecked="DisableWebHelper"/>
                            
                            <UniformGrid Columns="2">
                                <Button Content="Create a backup (RECOMMENDED)" Style="{StaticResource DangerAction}" Height="35" Margin="5,5,5,5" FontSize="11" Click="SteamBackup_Click" Background="#FF459A20"/>
                                <Button Content="Clean Steam Cache" Style="{StaticResource DangerAction}" Height="35" Margin="5" FontSize="11" Click="CleanCache_Click"/>
                                <Button Content="Config Backup" Style="{StaticResource DangerAction}" Height="35" Margin="5" FontSize="11" Click="ConfigBackup_Click"/>
                                <Button Content="Steam Folder" Style="{StaticResource DangerAction}" Height="35" Margin="5,5,5,5" FontSize="11" Click="Folder_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                    
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>